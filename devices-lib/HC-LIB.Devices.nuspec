<?xml version="1.0" encoding="utf-8" ?>
<package>
  <metadata>
    <id>HC-LIB.Devices</id>
    <version>1.1.2609</version>
    <title>Arduino Devices Library</title>
    <authors>Roman Gorielov</authors>
    <owners>Roman Gorielov</owners>
    <projectUrl>https://github.com/romango78/HC-LIB/tree/master/devices-lib</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Arduino device types: AnalogDevice, DigitalDevice, RelayDevice, AnalogSensor, and controllers using Error/Expected.</description>
    <releaseNotes>1.1.2609: PlatformIO at library root; controllers use Error/Expected. Requires System, Device.Abstractions, and IO-Port 1.1.2609.</releaseNotes>
    <copyright>Copyright 2026 Roman Gorielov</copyright>
    <tags>native arduino atmelavr device relay sensor</tags>
    <dependencies>
      <dependency id="HC-LIB.SYSTEM" version="1.1.2609" />
      <dependency id="HC-LIB.Device.Abstractions" version="1.1.2609" />
      <dependency id="HC-LIB.IO-Port" version="1.1.2609" />
    </dependencies>
    <summary>For Arduino projects</summary>
    <packageTypes>
      <packageType name="Dependency" />
    </packageTypes>
  </metadata>
  <files>
    <file src="src\devices\AnalogDevices.h" target="src\devices\AnalogDevices.h" />
    <file src="src\devices\DigitalDevices.h" target="src\devices\DigitalDevices.h" />
    <file src="src\devices\controllers\DigitalDeviceController.h" target="src\devices\controllers\DigitalDeviceController.h" />
    <file src="src\devices\controllers\DigitalDeviceController.cpp" target="src\devices\controllers\DigitalDeviceController.cpp" />
    <file src="src\devices\controllers\RelayDeviceController.h" target="src\devices\controllers\RelayDeviceController.h" />
    <file src="src\devices\controllers\RelayDeviceController.cpp" target="src\devices\controllers\RelayDeviceController.cpp" />
    <file src="src\sensors\AnalogSensor.h" target="src\sensors\AnalogSensor.h" />
    <file src="library.json" target="library.json" />
    <file src="library.properties" target="library.properties" />
    <file src="LICENSE.md" target="LICENSE.md" />
    <file src="README.md" target="README.md" />
  </files>
</package>
