<?xml version="1.0" encoding="utf-8" ?>
<package>
  <metadata>
    <id>HC-LIB.IO-Port</id>
    <version>1.1.2609</version>
    <title>IO Arduino Library</title>
    <authors>Roman Gorielov</authors>
    <owners>Roman Gorielov</owners>
    <projectUrl>https://github.com/romango78/HC-LIB/tree/master/io-port-lib</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Arduino port streams: DigitalStream, AnalogStream, VoltageStream, and pin adapters. Uses Error/IoError from HC-LIB.IO-Abstraction.</description>
    <releaseNotes>1.1.2609: PlatformIO at library root; streams use Error/IoError. Requires HC-LIB.SYSTEM 1.1.2609 and HC-LIB.IO-Abstractions 1.1.2609.</releaseNotes>
    <copyright>Copyright 2026 Roman Gorielov</copyright>
    <tags>native arduino atmelavr io port stream</tags>
    <dependencies>
      <dependency id="HC-LIB.SYSTEM" version="1.1.2609" />
      <dependency id="HC-LIB.IO-Abstractions" version="1.1.2609" />
    </dependencies>
    <summary>For Arduino projects</summary>
    <packageTypes>
      <packageType name="Dependency" />
    </packageTypes>
  </metadata>
  <files>
    <file src="src\adapter\IPortAdapter.h" target="src\adapter\IPortAdapter.h" />
    <file src="src\adapter\AnalogPortAdapter.cpp" target="src\adapter\AnalogPortAdapter.cpp" />
    <file src="src\adapter\AnalogPortAdapter.h" target="src\adapter\AnalogPortAdapter.h" />
    <file src="src\adapter\DigitalPortAdapter.cpp" target="src\adapter\DigitalPortAdapter.cpp" />
    <file src="src\adapter\DigitalPortAdapter.h" target="src\adapter\DigitalPortAdapter.h" />
    <file src="src\stream\IPortStream.h" target="src\stream\IPortStream.h" />
    <file src="src\stream\AnalogStream.cpp" target="src\stream\AnalogStream.cpp" />
    <file src="src\stream\AnalogStream.h" target="src\stream\AnalogStream.h" />
    <file src="src\stream\VoltageStream.h" target="src\stream\VoltageStream.h" />
    <file src="src\stream\VoltageStream.cpp" target="src\stream\VoltageStream.cpp" />
    <file src="src\stream\DigitalStream.cpp" target="src\stream\DigitalStream.cpp" />
    <file src="src\stream\DigitalStream.h" target="src\stream\DigitalStream.h" />
    <file src="library.json" target="library.json" />
    <file src="library.properties" target="library.properties" />
    <file src="LICENSE.md" target="LICENSE.md" />
    <file src="README.md" target="README.md" />
  </files>
</package>
