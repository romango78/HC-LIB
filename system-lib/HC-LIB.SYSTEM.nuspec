<?xml version="1.0" encoding="utf-8" ?>
<package>
  <metadata>
    <id>HC-LIB.SYSTEM</id>
    <version>1.1.2609</version>
    <title>Arduino System Library</title>
    <authors>Roman Gorielov</authors>
